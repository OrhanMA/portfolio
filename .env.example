# Resend — Email provider
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=

# Email address that receives contact form submissions
CONTACT_EMAIL=

# Sender address (must be a verified domain on Resend, or use their sandbox)
# For development, use the Resend sandbox: "Contact Portfolio <onboarding@resend.dev>"
# For production, use your verified domain: "Contact <contact@yourdomain.com>"
FROM_EMAIL=Contact Portfolio <onboarding@resend.dev>

# see: https://resend.com/domains
# you will need to connect a domain you own to resend to send and receive emails

# Google reCAPTCHA v3 (optional)
# Get your keys at https://www.google.com/recaptcha/admin
# Choose reCAPTCHA v3, add your domain(s)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Comma-separated hostnames accepted in verification responses
RECAPTCHA_ALLOWED_HOSTNAMES=orhanmadiassani.com,www.orhanmadiassani.com

# Durable contact rate limiting (required in production)
# Vercel KV aliases KV_REST_API_URL / KV_REST_API_TOKEN are also supported.
# The Vercel Upstash integration with the UPSTASH_REDIS_REST prefix is supported too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Tag Manager (optional)
# Get your container ID at https://tagmanager.google.com
# Format: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 (optional)
# Get your Measurement ID at https://analytics.google.com
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=
